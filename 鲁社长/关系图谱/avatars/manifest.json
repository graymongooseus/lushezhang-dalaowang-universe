  "p_hujintao": {
    "name": "胡锦涛",
    "image": "https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Chinese_President_Hu_Jintao_in_2011.jpg/330px-Chinese_President_Hu_Jintao_in_2011.jpg?utm_source=zh.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
    "source": "https://zh.wikipedia.org/wiki/%E8%83%A1%E9%94%A6%E6%B6%9B",
    "extract": "胡錦濤（1942年12月21日—），祖籍安徽绩溪，生於江蘇泰县（今江蘇泰州），原正国级领导人，毕业于清华大学水利工程系。其于2002至2012年间担任中共中央總書記，2003至2013年间担任中華人民共和國主席，2004至2013年间担任中共中央軍委主席、国家军委主席等职务，是中国党、政、军第四代的最高领导人，其任内的中央领导集体被称为“以胡锦涛同志为总书记的党中央”。\n",
    "file": "avatars/p_hujintao.jpg",
    "kind": "人物照片"
  },
